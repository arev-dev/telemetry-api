generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TelemetryEvent {
  id          String   @id @default(uuid())
  eventType   String
  platform    String?
  gameVersion String?
  message     String?
  isActive    Boolean?
  createdAt   DateTime @default(now())
  endedAt     DateTime? 
  totalSessionTime String?
}
