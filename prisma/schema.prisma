generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_VER__DATABASE_URL")
}

model TelemetryEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  platform         String?
  gameVersion      String?
  message          String?
  isActive         Boolean?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  endedAt          DateTime? @db.Timestamptz
  lastPingAt       DateTime  @default(now()) @db.Timestamptz
  totalSessionTime String?
}

model EmailLog {
  id         String   @id @default(uuid()) @db.Uuid
  SessionId  String   @db.Uuid
  toEmail    String
  subject    String
  htmlContent String
  sentAt     DateTime @default(now()) @db.Timestamptz
  status     String
  errorMsg   String?
}